# Names only. Real values live in .env.local (never committed) and in
# Vercel project settings. Do not run `vercel env pull .env.local`: it
# overwrites local-only values such as SEED_ADMIN_*.

# Neon Postgres. Local dev ignores these and uses in-memory PGlite unless
# USE_NEON_LOCALLY=1. Required on Vercel.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
USE_NEON_LOCALLY=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email (Resend). Optional; without a key, emails are logged in development.
RESEND_API_KEY=
EMAIL_FROM=
ORDER_NOTIFICATION_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Stripe (card payments). Injected by the Vercel Marketplace integration;
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` locally and the Stripe
# Dashboard in production. Leave all three unset to not offer card payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Neon seeding only (local, never on Vercel).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# Optional test fallback: a real Postgres instead of in-memory PGlite.
TEST_DATABASE_URL=

# HTTP e2e target, for example http://localhost:3002 (never port 3000).
E2E_BASE_URL=
